rules_version = '2';

// Who may read and write what. The document layout is described in
// core/data/src/main/kotlin/com/kokouliss/closetanything/core/data/firebase/FirestoreSchema.kt.
// Change both together, and run `npm test` in this folder before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Email invitations only count for an address the sign-in provider has verified.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited(household) {
      return request.auth.token.email_verified == true && myEmail() in household.invitedEmails;
    }

    function isMember(householdId) {
      return signedIn() && uid() in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // True when, after this write, the invite document for `code` points at this household.
    function inviteWillPointHere(householdId, code) {
      return getAfter(/databases/$(database)/documents/invites/$(code)).data.householdId == householdId;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    function validHousehold(household) {
      return household.keys().hasOnly(['name', 'ownerId', 'memberIds', 'members', 'inviteCode', 'invitedEmails', 'createdAt'])
        && validName(household.name)
        && household.ownerId is string
        && household.memberIds is list
        && household.members is map
        // Same alphabet as InviteCode in the app: no 0, 1, I or O.
        && household.inviteCode is string && household.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && household.invitedEmails is list;
    }

    function validRoom(room) {
      return room.keys().hasOnly(['name', 'createdAt']) && validName(room.name);
    }

    function validSpace(space) {
      return space.keys().hasOnly(['roomId', 'name', 'createdAt'])
        && space.roomId is string
        && validName(space.name);
    }

    function validThing(thing) {
      return thing.keys().hasOnly(['name', 'roomId', 'spaceId', 'boxId', 'box', 'note', 'quantity', 'tags', 'thumbnail',
          'createdByName', 'createdAt'])
        && validName(thing.name)
        && thing.roomId is string
        && thing.spaceId is string
        && (!('boxId' in thing) || thing.boxId is string)
        && (!('box' in thing) || thing.box is bool)
        && (!('note' in thing) || (thing.note is string && thing.note.size() <= 500))
        && (!('quantity' in thing) || (thing.quantity is int && thing.quantity >= 1 && thing.quantity <= 999))
        && (!('tags' in thing) || (thing.tags is list && thing.tags.size() <= 10))
        && (!('thumbnail' in thing) || (thing.thumbnail is bytes && thing.thumbnail.size() <= 60000))
        && thing.createdByName is string && thing.createdByName.size() <= 100;
    }

    match /households/{householdId} {
      // Members see their households. Invited people see the household so they can accept or decline.
      allow read: if signedIn() && (uid() in resource.data.memberIds || isInvited(resource.data));

      // A new household has exactly one member, its owner, and comes with its invite document.
      allow create: if signedIn()
        && validHousehold(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && request.resource.data.members[uid()].name is string
        && request.resource.data.invitedEmails.size() == 0
        && inviteWillPointHere(householdId, request.resource.data.inviteCode);

      allow update: if signedIn()
        && validHousehold(request.resource.data)
        && (ownerEdits() || memberEditsEmailInvites() || joinsWithCode()
            || acceptsEmailInvite() || declinesEmailInvite() || leaves() || handsOver() || renamesSelf());

      allow delete: if signedIn() && resource.data.ownerId == uid();

      function changedFields() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function changedMembers() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys();
      }

      // The owner may rename the household, remove members, manage email invites and replace the
      // invite code, but never hand the household to someone else or lock themselves out.
      function ownerEdits() {
        return resource.data.ownerId == uid()
          && changedFields().hasOnly(['name', 'inviteCode', 'memberIds', 'members', 'invitedEmails'])
          && uid() in request.resource.data.memberIds
          && (request.resource.data.inviteCode == resource.data.inviteCode
              || inviteWillPointHere(householdId, request.resource.data.inviteCode));
      }

      function memberEditsEmailInvites() {
        return uid() in resource.data.memberIds && changedFields().hasOnly(['invitedEmails']);
      }

      // The only change is that the caller appears as a new member.
      function addsOnlySelf() {
        return !(uid() in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && uid() in request.resource.data.memberIds
          && changedMembers().hasOnly([uid()])
          && request.resource.data.members[uid()].name is string
          && request.resource.data.members[uid()].name.size() <= 100;
      }

      // Someone who cannot read the household proves they know its code by writing it into their own
      // member entry. A wrong guess is simply rejected.
      function joinsWithCode() {
        return changedFields().hasOnly(['memberIds', 'members'])
          && addsOnlySelf()
          && request.resource.data.members[uid()].inviteCode == resource.data.inviteCode;
      }

      function removesOnlyOwnEmailInvite() {
        return request.resource.data.invitedEmails.toSet()
          == resource.data.invitedEmails.toSet().difference([myEmail()].toSet());
      }

      function acceptsEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['memberIds', 'members', 'invitedEmails'])
          && addsOnlySelf()
          && removesOnlyOwnEmailInvite();
      }

      function declinesEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['invitedEmails'])
          && removesOnlyOwnEmailInvite();
      }

      // The caller disappears from memberIds and members, and no other member changes.
      function removesOnlySelf() {
        return uid() in resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(uid() in request.resource.data.memberIds)
          && changedMembers().hasOnly([uid()])
          && !(uid() in request.resource.data.members);
      }

      // A member removes themselves and nothing else. The owner hands over or deletes the household instead.
      function leaves() {
        return uid() != resource.data.ownerId
          && changedFields().hasOnly(['memberIds', 'members'])
          && removesOnlySelf();
      }

      // A member changes the name in their own entry, and nothing else.
      function renamesSelf() {
        return uid() in resource.data.memberIds
          && changedFields().hasOnly(['members'])
          && changedMembers().hasOnly([uid()])
          && request.resource.data.members[uid()].diff(resource.data.members[uid()]).affectedKeys().hasOnly(['name'])
          && request.resource.data.members[uid()].name is string
          && request.resource.data.members[uid()].name.size() > 0
          && request.resource.data.members[uid()].name.size() <= 100;
      }

      // The owner leaves and makes another member the owner, so the household goes on without them.
      function handsOver() {
        return uid() == resource.data.ownerId
          && changedFields().hasOnly(['ownerId', 'memberIds', 'members'])
          && request.resource.data.ownerId in resource.data.memberIds
          && request.resource.data.ownerId != uid()
          && removesOnlySelf();
      }

      match /rooms/{roomId} {
        allow read, delete: if isMember(householdId);
        allow create, update: if isMember(householdId) && validRoom(request.resource.data);
      }

      match /spaces/{spaceId} {
        allow read, delete: if isMember(householdId);
        allow create, update: if isMember(householdId) && validSpace(request.resource.data);
      }

      match /things/{thingId} {
        allow read, delete: if isMember(householdId);
        allow create, update: if isMember(householdId) && validThing(request.resource.data);

        // The full-size photo of a thing, one document. A Firestore document holds at most 1 MiB.
        match /photo/{photoId} {
          allow read, delete: if isMember(householdId);
          allow create, update: if isMember(householdId)
            && photoId == 'full'
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 800000;
        }
      }
    }

    // invites/{code} maps an invite code to its household.
    match /invites/{code} {
      // Fetched by exact code only, so codes cannot be listed.
      allow get: if signedIn();
      allow list: if false;

      // Only together with a household, owned by the caller, that uses exactly this code.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId'])
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == uid()
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code;

      allow update: if false;

      allow delete: if signedIn()
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.ownerId == uid();
    }
  }
}
